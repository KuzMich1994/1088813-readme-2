{
  "name": "@project/blog",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/blog"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/blog/dist/package.json",
          "{workspaceRoot}/apps/blog/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/blog/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@project/blog:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@project/blog:build:development"
          },
          "production": {
            "buildTarget": "@project/blog:build:production"
          }
        }
      },
      "db:lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma validate --schema=./libs/blog/models/prisma/schema"
        }
      },
      "db:format": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma format --schema=./libs/blog/models/prisma/schema"
        }
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma migrate dev --schema=./libs/blog/models/prisma/schema --skip-generate --skip-seed"
        }
      },
      "db:reset": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma migrate reset --schema=./libs/blog/models/prisma/schema --force --skip-generate --skip-seed"
        }
      },
      "db:generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma generate --schema=./libs/blog/models/prisma/schema"
        }
      },
      "db:seed": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx libs/blog/models/prisma/seed.ts"
        }
      },
      "db:fresh:seed": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nx run @project/blog:db:reset && nx run @project/blog:db:seed"
        }
      }
    }
  },
  "dependencies": {}
}
